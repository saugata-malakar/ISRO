# NeuraLink Copilot — environment template.
# Copy to `.env` and fill in. NEVER commit a real .env (see .gitignore).
# Every value here is also overridable; the app falls back to config/settings.yaml.

# --- Crypto -------------------------------------------------------------------
# Master key for AES-256-GCM at-rest encryption. If unset, the app reads/creates
# data/runtime/master.key (0600). Provide as 64 hex chars (32 bytes) to override.
NEURALINK_MASTER_KEY=

# Secret used to sign the tamper-evident audit HMAC chain. If unset, derived from
# the master key. Provide 64 hex chars to override.
NEURALINK_AUDIT_KEY=

# --- Auth ---------------------------------------------------------------------
# Secret for signing local JWTs. If unset, derived from the master key.
NEURALINK_JWT_SECRET=

# --- Models (local files only — never fetched at runtime) ---------------------
# Path to the GGUF LLM. If missing AND llm.mock=false, the engine fails loudly.
NEURALINK_LLM_MODEL_PATH=data/models/qwen2.5-3b-instruct-q4_k_m.gguf
# Optional local embedding model dir (sentence-transformers). Empty => offline
# hashing/TF-IDF embedder (no download, fully deterministic).
NEURALINK_EMBED_MODEL_PATH=

# --- Runtime ------------------------------------------------------------------
NEURALINK_ENV=demo
